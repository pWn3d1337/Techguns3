# Normalize line endings: LF in the repository, native on checkout.
* text=auto

# Shell scripts must keep LF, Windows scripts CRLF.
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Generated files always use LF; keeps git from reporting line-ending-only changes.
src/generated/**/.cache/* text eol=lf
src/generated/**/*.json text eol=lf

# Binary assets
*.png binary
*.ogg binary
*.nbt binary
*.jar binary
